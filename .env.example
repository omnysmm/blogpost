# Yandex: https://oauth.yandex.ru
# OK:     https://apiok.ru/dev
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# OK_CLIENT_ID=
# OK_CLIENT_SECRET=
# OK_PUBLIC_KEY=
# OK_SECRET_KEY=

# AI providers (set as Supabase Edge Function secrets, not VITE_*)
# YANDEX_GPT_API_KEY= / YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# GIGACHAT_API_KEY=
# FUSIONBRAIN_API_KEY=
# FUSIONBRAIN_API_SECRET=

# Client-side AI fallbacks (optional, used when Edge Functions are not deployed)
VITE_YANDEX_GPT_API_KEY=
VITE_GIGACHAT_API_KEY=
VITE_FUSIONBRAIN_API_KEY=
VITE_FUSIONBRAIN_API_SECRET=

